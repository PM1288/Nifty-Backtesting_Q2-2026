      "tier": 1,
      "notes": "Tier 1 establishes comparison functionality."
    },
    {
      "strategy_version_id": "vwap_pullback_continuation_intraday_v1",
      "strategy_file": "../strategies/vwap_pullback_continuation_intraday_v1.json",
