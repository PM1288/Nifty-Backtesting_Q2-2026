{
  "$schema": "../../contracts/declarative-strategy-v2.schema.json",
  "strategy_id": "orb15_volume_breakout_intraday",
  "strategy_version_id": "orb15_volume_breakout_intraday_v1",
  "display_name": "15-Minute Opening-Range Breakout with Volume",
  "description": "Breakout comparator. After the first 15 minutes, enters when the completed close crosses above the opening-range high, remains above VWAP, has at least 1.5 times expected minute volume and closes in the upper 30 percent of its bar.",
  "version": 1,
  "status": "reference",
  "owner": "strategy-lab",
  "archetype": "breakout",
  "instrument_scope": "equity",
  "product": "equity_intraday",
  "universe": {
    "mode": "point_in_time_index_membership",
    "index_code": "NIFTY50",
    "series": [
      "EQ"
    ],
    "membership_as_of": "trade_date",
    "symbols": []
  },
  "calendar": {
    "exchange": "NSE",
    "segment": "CM",
    "timezone": "Asia/Kolkata",
    "regular_session": {
      "open": "09:15:00",
      "close": "15:30:00"
    }
  },
  "features": [
    {
      "feature_id": "previous_session_data_qualified",
      "registry_key": "quality.previous_session_qualified",
      "interval": "1d",
      "availability": "previous_completed_session",
      "lag_sessions": 1,
      "warmup_bars": 0,
      "calculation_version": "quality_gate_v1"
    },
    {
      "feature_id": "close_px",
      "registry_key": "canonical.close_px",
      "interval": "1m",
      "availability": "completed_bar",
      "lag_sessions": 0,
      "warmup_bars": 0,
      "calculation_version": "canonical_v1"
    },
    {
      "feature_id": "open_range_high_15",
      "registry_key": "canonical.open_range_high_15",
      "interval": "1m",
      "availability": "session_accumulated",
      "lag_sessions": 0,
      "warmup_bars": 0,
      "calculation_version": "opening_range_15_v1"
    },
    {
      "feature_id": "day_vwap",
      "registry_key": "canonical.day_vwap",
      "interval": "1m",
      "availability": "session_accumulated",
      "lag_sessions": 0,
      "warmup_bars": 0,
      "calculation_version": "session_vwap_v1"
    },
    {
      "feature_id": "minute_volume_ratio",
      "registry_key": "canonical.minute_volume_ratio",
      "interval": "1m",
      "availability": "completed_bar",
      "lag_sessions": 0,
      "warmup_bars": 0,
      "calculation_version": "minute_volume_profile_ratio_v1"
    },
    {
      "feature_id": "bar_close_location_pct",
      "registry_key": "canonical.bar_close_location_pct",
      "interval": "1m",
      "availability": "completed_bar",
      "lag_sessions": 0,
      "warmup_bars": 0,
      "calculation_version": "bar_close_location_v1"
    }
  ],
  "day_eligibility": {
    "all": [
      {
        "feature": "previous_session_data_qualified",
        "operator": "==",
        "value": true
      }
    ]
  },
  "entry": {
    "conditions": {
      "all": [
        {
          "feature": "close_px",
          "operator": "crosses_above",
          "compare_feature": "open_range_high_15"
        },
        {
          "feature": "close_px",
          "operator": ">",
          "compare_feature": "day_vwap"
        },
        {
          "feature": "minute_volume_ratio",
          "operator": ">=",
          "value": 1.5
        },
        {
          "feature": "bar_close_location_pct",
          "operator": ">=",
          "value": 70
        }
      ]
    },
    "trigger_mode": "first_true_per_symbol_per_day",
    "signal_on": "completed_bar",
    "execute_on": "next_bar_open",
    "allowed_signal_time": {
      "start": "09:30:00",
      "end": "13:30:00"
    }
  },
  "exit": {
    "conditions": {
      "any": [
        {
          "feature": "close_px",
          "operator": "crosses_below",
          "compare_feature": "day_vwap"
        },
        {
          "feature": "bar_close_location_pct",
          "operator": "<",
          "value": 30
        }
      ]
    },
    "signal_on": "completed_bar",
    "execute_on": "next_bar_open",
    "forced_session_exit": {
      "decision_time": "15:15:00",
      "fill_policy": "next_available_bar_open",
      "latest_fill_time": "15:20:00"
    },
    "carry_allowed": false,
    "price_stop": {
      "type": "percentage_from_entry",
      "value_pct": 0.75,
      "trigger_on": "intrabar_low",
      "fill_policy": "stop_price_with_slippage",
      "active_after_entry_bars": 1
    }
  },
  "position_rules": {
    "side": "long",
    "one_position_per_symbol": true,
    "max_completed_trades_per_symbol_per_day": 1,
    "reentry_after_exit": false
  },
  "economics": {
    "ticket_size_inr": 200000,
    "evaluation_target_net_pnl_inr": 500,
    "fee_profile_id": "zerodha_equity_intraday_effective_dated",
    "execution_model_id": "next_bar_open_slippage_2_5bps_v1",
    "slippage_bps_per_side": 2.5
  },
  "data_policy": {
    "bar_interval": "1m",
    "bar_timestamp_semantics": "bar_start",
    "admitted_quality_statuses": [
      "PASS",
      "WARN"
    ],
    "missing_feature_action": "skip_and_log",
    "missing_next_bar_action": "fail_trade_and_log",
    "corporate_action_policy": "canonical_point_in_time_adjusted_series"
  },
  "reporting": {
    "persist_signals": true,
    "persist_skipped_signals": true,
    "persist_feature_snapshots": true,
    "persist_pdiagram_snapshots": true,
    "breakdowns": [
      "symbol",
      "sector",
      "trade_date",
      "entry_time_bucket",
      "market_regime",
      "exit_reason",
      "data_quality_status"
    ]
  },
  "assumptions": {
    "opening_range": "09:15 through 09:29 completed bars; earliest signal is 09:30.",
    "volume": "Uses the canonical minute-of-day volume profile, not raw absolute volume.",
    "stop": "0.75 percent price stop."
  }
}