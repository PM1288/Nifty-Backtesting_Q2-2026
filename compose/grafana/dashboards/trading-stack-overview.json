    {
      "id": 8,
      "type": "table",
      "title": "Daily Test Quick Check",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "WITH coverage AS (\n  SELECT coverage_ratio::numeric AS value\n  FROM metrics_1m\n  WHERE source_name = 'equity_ticks'\n  ORDER BY minute_ts DESC\n  LIMIT 1\n)\nSELECT 'bars_last_5m' AS metric, count(*)::numeric AS value\nFROM bars_1m\nWHERE ts > now() - interval '5 minutes'\nUNION ALL\nSELECT 'seen_last_15s' AS metric, count(*)::numeric AS value\nFROM instrument_state\nWHERE last_seen_ts > now() - interval '15 seconds'\nUNION ALL\nSELECT 'equity_coverage_ratio' AS metric, COALESCE((SELECT value FROM coverage), 0::numeric) AS value\nUNION ALL\nSELECT 'api_429_last_5m' AS metric, count(*)::numeric AS value\nFROM api_request_log\nWHERE ts > now() - interval '5 minutes' AND http_status = 429;",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 9,
      "type": "stat",
