          "rawSql": "SELECT s.ts,\n       s.strategy,\n       s.exchange,\n       COALESCE(u.tradingsymbol, subs.tradingsymbol, s.symbol_token) AS symbol,\n       s.side,\n       s.confidence,\n       s.entry_price,\n       s.stop_loss,\n       s.take_profit,\n       s.reason\nFROM strategy_signals s\nLEFT JOIN instrument_universe u ON u.exchange = s.exchange AND u.symbol_token = s.symbol_token\nLEFT JOIN subscriptions subs ON subs.symbol_token = s.symbol_token\nORDER BY s.ts DESC LIMIT 20;",
