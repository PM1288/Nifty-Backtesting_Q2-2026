      "targets": [
        {
          "format": "time_series",
          "rawSql": "WITH buckets AS (\n  SELECT generate_series(\n    date_trunc('minute', now() - interval '24 hours'),\n    date_trunc('minute', now()),\n    interval '5 minutes'\n  ) AS bucket_ts\n), counts AS (\n  SELECT date_trunc('minute', ts) AS bucket_ts, COUNT(*) AS cnt\n  FROM strategy_signals\n  WHERE ts > now() - interval '24 hours'\n  GROUP BY 1\n)\nSELECT b.bucket_ts AS \"time\", COALESCE(c.cnt, 0) AS value\nFROM buckets b\nLEFT JOIN counts c ON c.bucket_ts = b.bucket_ts\nORDER BY 1;",
          "refId": "A"
