                   {
                       "id":  4,
                       "type":  "stat",
                       "title":  "Equity Breadth (Adv-Dec)",
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "postgres"
                                      },
                       "gridPos":  {
                                       "h":  5,
                                       "w":  6,
                                       "x":  18,
                                       "y":  0
                                   },
                       "targets":  [
                                       {
                                           "format":  "table",
                                           "rawSql":  "WITH bars_today AS (\n  SELECT b.*\n  FROM bars_1m b\n  JOIN instrument_universe u ON u.exchange = b.exchange AND u.symbol_token = b.symbol_token\n  WHERE u.universe_name = \u0027nifty100_equity\u0027\n    AND u.active_to IS NULL\n    AND (b.ts AT TIME ZONE \u0027Asia/Kolkata\u0027)::date = (now() AT TIME ZONE \u0027Asia/Kolkata\u0027)::date\n),\nfirst_bar AS (\n  SELECT DISTINCT ON (exchange, symbol_token) exchange, symbol_token, open\n  FROM bars_today\n  ORDER BY exchange, symbol_token, ts ASC\n),\nlast_bar AS (\n  SELECT DISTINCT ON (exchange, symbol_token) exchange, symbol_token, close\n  FROM bars_today\n  ORDER BY exchange, symbol_token, ts DESC\n)\nSELECT\n  (SELECT COUNT(*) FROM last_bar l JOIN first_bar f USING (exchange, symbol_token) WHERE l.close \u003e f.open) AS advancers,\n  (SELECT COUNT(*) FROM last_bar l JOIN first_bar f USING (exchange, symbol_token) WHERE l.close \u003c f.open) AS decliners;\n",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ],
