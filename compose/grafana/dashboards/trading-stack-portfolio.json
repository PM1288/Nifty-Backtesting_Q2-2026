                                       "w":  24,
                                       "x":  0,
                                       "y":  0
                                   },
                       "options":  {
                                       "mode":  "html",
                                       "content":  "\u003cdiv style=\"font-family:monospace;\"\u003e\n  \u003ch3\u003eAdd / Update Position\u003c/h3\u003e\n  \u003cform id=\"addForm\" style=\"display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end;\"\u003e\n    \u003clabel\u003eSymbol\u003cbr\u003e\u003cinput id=\"symbol\" required placeholder=\"RELIANCE\" /\u003e\u003c/label\u003e\n    \u003clabel\u003eExchange\u003cbr\u003e\u003cinput id=\"exchange\" value=\"NSE\" /\u003e\u003c/label\u003e\n    \u003clabel\u003eQuantity\u003cbr\u003e\u003cinput id=\"qty\" type=\"number\" step=\"1\" required /\u003e\u003c/label\u003e\n    \u003clabel\u003eEntry Price\u003cbr\u003e\u003cinput id=\"price\" type=\"number\" step=\"0.01\" required /\u003e\u003c/label\u003e\n    \u003clabel\u003eNotes\u003cbr\u003e\u003cinput id=\"notes\" placeholder=\"optional\" /\u003e\u003c/label\u003e\n    \u003cbutton type=\"submit\"\u003eAdd\u003c/button\u003e\n  \u003c/form\u003e\n  \u003cdiv id=\"msg\" style=\"margin-top:8px;color:#0f0;\"\u003e\u003c/div\u003e\n  \u003ch3 style=\"margin-top:16px;\"\u003ePositions\u003c/h3\u003e\n  \u003ctable id=\"positions\" style=\"width:100%;border-collapse:collapse;\"\u003e\u003c/table\u003e\n\u003c/div\u003e\n\u003cscript\u003e\nconst api = \u0027/backend/portfolio/positions\u0027;\nconst msg = document.getElementById(\u0027msg\u0027);\nconst tbl = document.getElementById(\u0027positions\u0027);\nfunction flash(text, ok=true){ msg.style.color = ok ? \u0027#0f0\u0027 : \u0027#f66\u0027; msg.textContent = text; setTimeout(()=\u003emsg.textContent=\u0027\u0027,4000); }\nasync function load(){\n  try{\n    const res = await fetch(api+\u0027?status=all\u0027, {credentials:\u0027include\u0027});\n    const data = await res.json();\n    const rows = (data.positions||[]);\n    const header = \u0027\u003ctr style=\"border-bottom:1px solid #666\"\u003e\u003cth\u003eID\u003c/th\u003e\u003cth\u003eSymbol\u003c/th\u003e\u003cth\u003eStatus\u003c/th\u003e\u003cth\u003eQty\u003c/th\u003e\u003cth\u003eEntry\u003c/th\u003e\u003cth\u003eLast/Exit\u003c/th\u003e\u003cth\u003ePNL\u003c/th\u003e\u003cth\u003eAction\u003c/th\u003e\u003c/tr\u003e\u0027;\n    const body = rows.map(r=\u003e{\n      const last = r.status===\u0027closed\u0027 ? (r.exit_price??\u0027-\u0027) : (r.last_price??\u0027-\u0027);\n      const pnl = r.pnl===null||r.pnl===undefined ? \u0027-\u0027 : r.pnl.toFixed(2);\n      const btn = r.status===\u0027open\u0027 ? `\u003cbutton onclick=\\\"closePos(${r.id})\\\"\u003eClose\u003c/button\u003e` : \u0027\u0027;\n      return `\u003ctr style=\\\"border-bottom:1px solid #333\\\"\u003e\u003ctd\u003e${r.id}\u003c/td\u003e\u003ctd\u003e${r.exchange}:${r.symbol}\u003c/td\u003e\u003ctd\u003e${r.status}\u003c/td\u003e\u003ctd\u003e${r.quantity}\u003c/td\u003e\u003ctd\u003e${r.entry_price}\u003c/td\u003e\u003ctd\u003e${last}\u003c/td\u003e\u003ctd\u003e${pnl}\u003c/td\u003e\u003ctd\u003e${btn}\u003c/td\u003e\u003c/tr\u003e`;\n    }).join(\u0027\u0027);\n    tbl.innerHTML = header + body;\n  }catch(err){\n    flash(\u0027Load failed: \u0027+err, false);\n  }\n}\nwindow.closePos = async function(id){\n  const p = prompt(\u0027Exit price?\u0027);\n  if(!p) return;\n  const price = parseFloat(p);\n  if(isNaN(price)) { flash(\u0027Invalid price\u0027, false); return; }\n  const res = await fetch(api+`/${id}/close`, {method:\u0027POST\u0027,headers:{\u0027Content-Type\u0027:\u0027application/json\u0027},credentials:\u0027include\u0027,body:JSON.stringify({exit_price:price})});\n  if(!res.ok){ const t = await res.text(); flash(\u0027Close failed: \u0027+t,false); return; }\n  flash(\u0027Closed position \u0027+id);\n  load();\n}\nconst form = document.getElementById(\u0027addForm\u0027);\nform.onsubmit = async (e)=\u003e{\n  e.preventDefault();\n  const body = {\n    symbol: document.getElementById(\u0027symbol\u0027).value.trim(),\n    exchange: document.getElementById(\u0027exchange\u0027).value.trim() || \u0027NSE\u0027,\n    quantity: parseFloat(document.getElementById(\u0027qty\u0027).value),\n    entry_price: parseFloat(document.getElementById(\u0027price\u0027).value),\n    notes: document.getElementById(\u0027notes\u0027).value\n  };\n  const res = await fetch(api, {method:\u0027POST\u0027,headers:{\u0027Content-Type\u0027:\u0027application/json\u0027},credentials:\u0027include\u0027,body:JSON.stringify(body)});\n  if(!res.ok){ const t = await res.text(); flash(\u0027Add failed: \u0027+t,false); return; }\n  flash(\u0027Position added\u0027);\n  form.reset();\n  load();\n};\nload();\n\u003c/script\u003e\n"
                                   }
                   }
               ]
}
