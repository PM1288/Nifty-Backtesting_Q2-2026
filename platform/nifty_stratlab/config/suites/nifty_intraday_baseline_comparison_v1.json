  "suite_id": "nifty_intraday_baseline_comparison_v1",
  "version": 1,
  "display_name": "NIFTY Intraday Baseline Strategy Comparison Suite",
  "description": "A controlled comparison suite containing a non-alpha fixed-time control and eight widely recognised strategy archetypes. All strategies are long-only cash-equity intraday references and must be compared on identical point-in-time data, costs, execution assumptions and isolated capital.",
  "status": "reference",
  "strategies": [
    {
