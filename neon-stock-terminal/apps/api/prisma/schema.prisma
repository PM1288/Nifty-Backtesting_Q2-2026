generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AssetType {
  EQUITY
  INDEX
}

model Sector {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  stocks    Stock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stock {
  id         Int       @id @default(autoincrement())
  symbol     String    @unique
  name       String
  assetType  AssetType @default(EQUITY)

  sectorId   Int?
  sector     Sector?   @relation(fields: [sectorId], references: [id])

  isNifty50  Boolean   @default(false)
  isNifty100 Boolean   @default(false)

  intradayBars   IntradayBar[]
  dailySnapshots DailySnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailySnapshot {
  id        Int      @id @default(autoincrement())
  stockId   Int
  stock     Stock    @relation(fields: [stockId], references: [id])

  /// Calendar day key (stored as DateTime but treated as a day bucket).
  /// In this repo we generate the key using Asia/Kolkata start-of-day converted to UTC.
  date      DateTime

  prevClose Decimal  @db.Decimal(18, 6)
  open      Decimal  @db.Decimal(18, 6)
  high      Decimal  @db.Decimal(18, 6)
  low       Decimal  @db.Decimal(18, 6)
  close     Decimal  @db.Decimal(18, 6)
  volume    BigInt?

  createdAt DateTime @default(now())

  @@unique([stockId, date])
}

model IntradayBar {
  id      BigInt   @id @default(autoincrement())
  stockId Int
  stock   Stock    @relation(fields: [stockId], references: [id])

  ts      DateTime

  open    Decimal  @db.Decimal(18, 6)
  high    Decimal  @db.Decimal(18, 6)
  low     Decimal  @db.Decimal(18, 6)
  close   Decimal  @db.Decimal(18, 6)
  volume  BigInt?

  createdAt DateTime @default(now())

  @@index([stockId, ts])
}
