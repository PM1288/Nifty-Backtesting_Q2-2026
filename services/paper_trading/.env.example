PAPER_TRADING_ONLY=true
DATABASE_URL=postgresql://trader:CHANGE_ME@postgres:5432/tradingdb
MARKET_DATA_DATABASE_URL=postgresql://paper_market_reader:CHANGE_ME@postgres:5432/tradingdb
PAPER_TRADING_SCHEMA=paper_trading
MARKET_DATA_SCHEMA=public
MARKET_DATA_BAR_TABLE=bars_1m
MARKET_DATA_INSTRUMENT_TABLE=instruments
API_SERVICE_TOKENS=replace-with-long-random-service-token
EXCHANGE_TIMEZONE=Asia/Kolkata
POLL_INTERVAL_SECONDS=2
MARKET_DATA_STALE_SECONDS=360
SAME_BAR_AMBIGUITY_POLICY=WORST_CASE
DEFAULT_ACCOUNT_ID=paper-main
STARTING_PAPER_CAPITAL=1600000
DEFAULT_INCOME_TAX_RATE=0.35
# Direct WhatsApp gateway (preferred). The recipient is configuration, never code.
WA_GATEWAY_ENABLED=true
WA_GATEWAY_URL=https://wweb.noviusrailtech.com/webhook/send
WA_GATEWAY_API_TOKEN_FILE=/run/secrets/whatsapp_gateway_api_token
WA_MYSELF_CHAT_ID=replace-with-whatsapp-chat-id
WA_ENTRY_CHART_ENABLED=true
# Transient feed flaps remain durable in PostgreSQL but do not interrupt chat.
WA_DATA_ALERT_MIN_AFFECTED=10
WA_DATA_ALERT_MIN_DURATION_SECONDS=1200
# Legacy n8n fallback; only required when WA_GATEWAY_ENABLED=false.
N8N_WEBHOOK_URL=https://example.invalid/webhook/codex-paper-trade
N8N_CRITICAL_WEBHOOK_URL=
N8N_BASIC_USERNAME=replace-me
N8N_BASIC_PASSWORD=replace-me
WEBHOOK_SIGNING_SECRET=replace-with-at-least-24-random-characters
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=12
WEBHOOK_BASE_RETRY_SECONDS=5
DAILY_SUMMARY_TIME=16:00
WEEKLY_SUMMARY_DAY=5
WEEKLY_SUMMARY_TIME=10:00
VALUATION_SNAPSHOT_MODE=EVENTS_AND_EOD
LOG_LEVEL=INFO
METRICS_ENABLED=true
