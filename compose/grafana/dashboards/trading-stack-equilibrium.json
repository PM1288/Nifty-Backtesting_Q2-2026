                                           "format":  "table",
                                           "rawSql":  "WITH picked AS (\n  SELECT CASE WHEN \u0027$expiry\u0027 = \u0027latest\u0027 THEN (SELECT max(expiry) FROM equilibrium_mean_series WHERE underlying = \u0027$underlying\u0027) WHEN \u0027$expiry\u0027 LIKE \u0027%-%\u0027 THEN to_date(NULLIF(\u0027$expiry\u0027,\u0027latest\u0027), \u0027YYYY-MM-DD\u0027) ELSE to_timestamp((NULLIF(regexp_replace(\u0027$expiry\u0027,\u0027\\D\u0027,\u0027\u0027,\u0027g\u0027),\u0027\u0027)::double precision) / 1000)::date END AS expiry\n)\nSELECT extract(epoch from max(ts)) * 1000 AS value\nFROM equilibrium_mean_series e\nJOIN picked p ON e.expiry = p.expiry\nWHERE e.underlying = \u0027$underlying\u0027;",
                                           "refId":  "A"
                                       }
