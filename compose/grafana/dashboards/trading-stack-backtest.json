          "format": "table",
          "rawSql": "SELECT entry_time, exit_time, symbol, tradingsymbol, success, gain_pct, net_profit, holding_days\nFROM a02_archive_swing_results\nUNION ALL\nSELECT now() AS entry_time,\n       now() AS exit_time,\n       'NO_DATA'::text AS symbol,\n       'NO_DATA'::text AS tradingsymbol,\n       false AS success,\n       0::numeric AS gain_pct,\n       0::numeric AS net_profit,\n       0::integer AS holding_days\nWHERE NOT EXISTS (SELECT 1 FROM a02_archive_swing_results)\nORDER BY entry_time DESC\nLIMIT 25;",
          "refId": "A"
        }
