                       "targets":  [
                                       {
                                           "format":  "table",
                                           "rawSql":  "WITH picked AS (\n  SELECT CASE WHEN \u0027$expiry\u0027 = \u0027latest\u0027 THEN (SELECT max(expiry) FROM max_pain_runs WHERE underlying = \u0027$underlying\u0027) WHEN \u0027$expiry\u0027 LIKE \u0027%-%\u0027 THEN to_date(NULLIF(\u0027$expiry\u0027,\u0027latest\u0027), \u0027YYYY-MM-DD\u0027) ELSE to_timestamp((NULLIF(regexp_replace(\u0027$expiry\u0027,\u0027\\\\D\u0027,\u0027\u0027,\u0027g\u0027),\u0027\u0027)::double precision) / 1000)::date END AS expiry\n), latest_run AS (\n  SELECT run_id FROM max_pain_runs r\n  JOIN picked p ON r.expiry = p.expiry\n  WHERE r.underlying = \u0027$underlying\u0027 AND r.status = \u0027success\u0027\n  ORDER BY r.finished_at DESC NULLS LAST, r.started_at DESC\n  LIMIT 1\n)\nSELECT strike, ce_oi, pe_oi, ce_pain, pe_pain, total_pain\nFROM max_pain_levels l\nWHERE l.run_id = (SELECT run_id FROM latest_run)\nORDER BY strike;",
