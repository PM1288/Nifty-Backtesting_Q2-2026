                                           "rawSql":  "WITH picked AS (\n  SELECT CASE WHEN \u0027$expiry\u0027 = \u0027latest\u0027 THEN (SELECT max(expiry) FROM max_pain_summary WHERE underlying = \u0027$underlying\u0027) WHEN \u0027$expiry\u0027 LIKE \u0027%-%\u0027 THEN to_date(NULLIF(\u0027$expiry\u0027,\u0027latest\u0027), \u0027YYYY-MM-DD\u0027) ELSE to_timestamp((NULLIF(regexp_replace(\u0027$expiry\u0027,\u0027\\\\D\u0027,\u0027\u0027,\u0027g\u0027),\u0027\u0027)::double precision) / 1000)::date END AS expiry\n)\nSELECT COALESCE(to_char(max(updated_at) AT TIME ZONE \u0027Asia/Kolkata\u0027, \u0027YYYY-MM-DD HH24:MI:SS\u0027), \u0027\u0027) AS value\nFROM max_pain_summary s\nJOIN picked p ON s.expiry = p.expiry\nWHERE s.underlying = \u0027$underlying\u0027;",
