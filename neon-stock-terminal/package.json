{
  "name": "neon-stock-terminal",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c auto \"npm run dev --workspace=@app/api\" \"npm run dev --workspace=@app/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier -w .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "utm:generate": "node scripts/generate-utm.mjs",
    "guard:camera": "node scripts/check-no-camera.mjs",
    "test": "npm test --workspaces --if-present",
    "audit": "npm audit"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
