    {
      "id": 14,
      "type": "stat",
      "title": "Breadth Ratio (Adv/Dec)",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "WITH bars_today AS (\n  SELECT b.*\n  FROM bars_1m b\n  JOIN instrument_universe u ON u.exchange = b.exchange AND u.symbol_token = b.symbol_token\n  WHERE u.universe_name = 'nifty100_equity'\n    AND u.active_to IS NULL\n    AND (b.ts AT TIME ZONE 'Asia/Kolkata')::date = (now() AT TIME ZONE 'Asia/Kolkata')::date\n),\nfirst_bar AS (\n  SELECT DISTINCT ON (exchange, symbol_token) exchange, symbol_token, open\n  FROM bars_today\n  ORDER BY exchange, symbol_token, ts ASC\n),\nlast_bar AS (\n  SELECT DISTINCT ON (exchange, symbol_token) exchange, symbol_token, close\n  FROM bars_today\n  ORDER BY exchange, symbol_token, ts DESC\n),\nagg AS (\n  SELECT\n    SUM(CASE WHEN l.close > f.open THEN 1 ELSE 0 END) AS advancers,\n    SUM(CASE WHEN l.close < f.open THEN 1 ELSE 0 END) AS decliners\n  FROM first_bar f\n  JOIN last_bar l USING (exchange, symbol_token)\n)\nSELECT ROUND(advancers::numeric / NULLIF(decliners::numeric, 0), 2) AS value FROM agg;",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.85
              },
              {
                "color": "yellow",
                "value": 1.0
              },
              {
                "color": "green",
                "value": 1.2
              },
              {
                "color": "blue",
                "value": 1.5
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
