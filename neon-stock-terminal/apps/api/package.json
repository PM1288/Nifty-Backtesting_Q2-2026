{
  "name": "@app/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "discord:dispatcher": "node dist/scripts/discordStreamDispatcher.js",
    "test": "tsx --test src/**/*.test.ts",
    "db:bootstrap": "tsx src/scripts/bootstrapDatabase.ts",
    "snapshots:refresh": "node dist/scripts/materializeSnapshots.js",
    "trade-quality:backfill": "tsx src/scripts/backfillTradeQuality.ts",
    "notification:test": "tsx src/scripts/sendTestNotification.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "14.2.0",
    "helmet": "^7.1.0",
    "luxon": "^3.5.0",
    "redis": "^5.11.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.6.2",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.14",
    "eslint": "^9.9.1",
    "prisma": "^5.18.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^7.18.0"
  }
}
