      "targets": [
        {
          "format": "table",
          "rawSql": "WITH latest_perf AS (\n  SELECT symbol, pct_intraday\n  FROM symbol_perf_snapshot\n  WHERE index_name='NIFTY100'\n    AND ts=(SELECT max(ts) FROM symbol_perf_snapshot WHERE index_name='NIFTY100')\n), pick AS (\n  SELECT COALESCE(symbol,'NA') AS symbol,\n         COALESCE(round(pct_intraday::numeric,2),0)::numeric AS pct_change\n  FROM latest_perf\n  ORDER BY pct_intraday DESC NULLS LAST\n  LIMIT 1\n)\nSELECT symbol, pct_change FROM pick\nUNION ALL\nSELECT 'NA'::text AS symbol, 0::numeric AS pct_change\nWHERE NOT EXISTS (SELECT 1 FROM pick);",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
