                   {
                       "id":  7,
                       "type":  "table",
                       "title":  "Top Gainers (NIFTY100 Intraday)",
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "postgres"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  13
                                   },
                       "targets":  [
                                       {
                                           "format":  "table",
                                           "rawSql":  "WITH bars_today AS (\n  SELECT b.*\n  FROM bars_1m b\n  JOIN instrument_universe u ON u.exchange = b.exchange AND u.symbol_token = b.symbol_token\n  WHERE u.universe_name = \u0027nifty100_equity\u0027\n    AND u.active_to IS NULL\n    AND (b.ts AT TIME ZONE \u0027Asia/Kolkata\u0027)::date = (now() AT TIME ZONE \u0027Asia/Kolkata\u0027)::date\n),\nfirst_bar AS (\n  SELECT DISTINCT ON (exchange, symbol_token) exchange, symbol_token, open\n  FROM bars_today\n  ORDER BY exchange, symbol_token, ts ASC\n),\nlast_bar AS (\n  SELECT DISTINCT ON (exchange, symbol_token) exchange, symbol_token, close\n  FROM bars_today\n  ORDER BY exchange, symbol_token, ts DESC\n)\nSELECT u.tradingsymbol AS symbol,\n       l.close AS last_price,\n       f.open AS day_open,\n       ROUND((l.close - f.open) * 100.0 / NULLIF(f.open, 0), 2) AS pct_change\nFROM first_bar f\nJOIN last_bar l USING (exchange, symbol_token)\nJOIN instrument_universe u ON u.exchange = l.exchange AND u.symbol_token = l.symbol_token\nORDER BY pct_change DESC\nLIMIT 10;\n",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "showHeader":  true
                                   }
                   },
                   {
                       "id":  8,
                       "type":  "table",
                       "title":  "Top Losers (NIFTY100 Intraday)",
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "postgres"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  12,
                                       "y":  13
                                   },
                       "targets":  [
                                       {
                                           "format":  "table",
                                           "rawSql":  "WITH bars_today AS (\n  SELECT b.*\n  FROM bars_1m b\n  JOIN instrument_universe u ON u.exchange = b.exchange AND u.symbol_token = b.symbol_token\n  WHERE u.universe_name = \u0027nifty100_equity\u0027\n    AND u.active_to IS NULL\n    AND (b.ts AT TIME ZONE \u0027Asia/Kolkata\u0027)::date = (now() AT TIME ZONE \u0027Asia/Kolkata\u0027)::date\n),\nfirst_bar AS (\n  SELECT DISTINCT ON (exchange, symbol_token) exchange, symbol_token, open\n  FROM bars_today\n  ORDER BY exchange, symbol_token, ts ASC\n),\nlast_bar AS (\n  SELECT DISTINCT ON (exchange, symbol_token) exchange, symbol_token, close\n  FROM bars_today\n  ORDER BY exchange, symbol_token, ts DESC\n)\nSELECT u.tradingsymbol AS symbol,\n       l.close AS last_price,\n       f.open AS day_open,\n       ROUND((l.close - f.open) * 100.0 / NULLIF(f.open, 0), 2) AS pct_change\nFROM first_bar f\nJOIN last_bar l USING (exchange, symbol_token)\nJOIN instrument_universe u ON u.exchange = l.exchange AND u.symbol_token = l.symbol_token\nORDER BY pct_change ASC\nLIMIT 10;\n",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "showHeader":  true
                                   }
                   },
                   {
                       "id":  9,
                       "type":  "table",
                       "title":  "NIFTY50 Options (Active Slice)",
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "postgres"
                                      },
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  0,
                                       "y":  21
                                   },
                       "targets":  [
                                       {
                                           "format":  "table",
                                           "rawSql":  "WITH opts AS (\n  SELECT exchange, symbol_token, tradingsymbol, strike, \"right\", expiry\n  FROM subscriptions\n  WHERE active = true AND kind = \u0027OPTIDX\u0027 AND upper(underlying) = \u0027NIFTY50\u0027\n),\nexpiry_sel AS (\n  SELECT min(expiry) AS expiry FROM opts\n)\nSELECT o.tradingsymbol,\n       o.strike,\n       o.\"right\",\n       o.expiry,\n       s.last_price AS ltp,\n       s.last_seen_ts\nFROM opts o\nJOIN expiry_sel e ON o.expiry = e.expiry\nLEFT JOIN instrument_state s ON s.exchange = o.exchange AND s.symbol_token = o.symbol_token\nORDER BY o.strike, o.\"right\";\n",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "showHeader":  true
                                   }
                   },
                   {
                       "id":  10,
                       "type":  "table",
                       "title":  "Futures (Active)",
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "postgres"
                                      },
                       "gridPos":  {
                                       "h":  9,
                                       "w":  12,
                                       "x":  12,
                                       "y":  21
                                   },
                       "targets":  [
                                       {
                                           "format":  "table",
                                           "rawSql":  "WITH futs AS (\n  SELECT exchange, symbol_token, tradingsymbol, underlying, expiry\n  FROM subscriptions\n  WHERE active = true AND kind = \u0027FUT\u0027\n),\nlatest_oi AS (\n  SELECT DISTINCT ON (exchange, symbol_token) exchange, symbol_token, oi\n  FROM oi_snapshots_futures\n  ORDER BY exchange, symbol_token, ts DESC\n)\nSELECT f.underlying,\n       f.tradingsymbol,\n       f.expiry,\n       s.last_price AS ltp,\n       o.oi\nFROM futs f\nLEFT JOIN instrument_state s ON s.exchange = f.exchange AND s.symbol_token = f.symbol_token\nLEFT JOIN latest_oi o ON o.exchange = f.exchange AND o.symbol_token = f.symbol_token\nORDER BY f.underlying\nLIMIT 50;\n",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "showHeader":  true
                                   }
                   },
                   {
                       "id":  11,
                       "type":  "table",
                       "title":  "Order Imbalance (NIFTY100)",
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "postgres"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  30
                                   },
                       "targets":  [
                                       {
                                           "format":  "table",
                                           "rawSql":  "SELECT u.tradingsymbol AS symbol,\n       s.total_buy_qty,\n       s.total_sell_qty,\n       (COALESCE(s.total_buy_qty, 0) - COALESCE(s.total_sell_qty, 0)) AS imbalance,\n       s.last_price,\n       s.last_seen_ts\nFROM instrument_state s\nJOIN instrument_universe u ON u.exchange = s.exchange AND u.symbol_token = s.symbol_token\nWHERE u.universe_name = \u0027nifty100_equity\u0027\n  AND u.active_to IS NULL\nORDER BY imbalance DESC NULLS LAST\nLIMIT 15;\n",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "showHeader":  true
                                   }
                   },
