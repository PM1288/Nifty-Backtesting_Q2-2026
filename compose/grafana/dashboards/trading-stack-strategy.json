          "rawSql": "SELECT t.ts,\n       t.strategy,\n       t.exchange,\n       COALESCE(u.tradingsymbol, subs.tradingsymbol, t.symbol_token) AS symbol,\n       t.side,\n       t.qty,\n       t.price,\n       t.fees\nFROM paper_trades t\nLEFT JOIN instrument_universe u ON u.exchange = t.exchange AND u.symbol_token = t.symbol_token\nLEFT JOIN subscriptions subs ON subs.symbol_token = t.symbol_token\nUNION ALL\nSELECT now() AS ts,\n       'system' AS strategy,\n       'NSE' AS exchange,\n       'NO_RECENT_TRADES' AS symbol,\n       'NA' AS side,\n       0::numeric AS qty,\n       0::numeric AS price,\n       0::numeric AS fees\nWHERE NOT EXISTS (SELECT 1 FROM paper_trades)\nORDER BY ts DESC LIMIT 20;",
