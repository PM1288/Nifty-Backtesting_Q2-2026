  "components": {
    "schemas": {
      "AnalyticsPolicy": {
        "properties": {
          "apply_default_ladders": {
            "type": "boolean",
            "title": "Apply Default Ladders",
            "default": true
          },
          "intraday_targets_pct": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "array",
            "title": "Intraday Targets Pct",
            "default": [
              "0.003",
              "0.005",
              "0.010"
            ]
          },
          "swing_targets_pct": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "array",
            "title": "Swing Targets Pct",
            "default": [
              "0.010",
              "0.030",
              "0.050"
            ]
          },
          "horizons_trading_sessions": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Horizons Trading Sessions",
            "default": [
              5,
              30
            ]
          },
          "track_after_execution_close": {
            "type": "boolean",
            "title": "Track After Execution Close",
            "default": true
          },
          "snapshot_cadence": {
            "type": "string",
            "enum": [
              "EVENTS_ONLY",
              "EVENTS_AND_EOD",
              "EVERY_BAR"
            ],
            "title": "Snapshot Cadence",
            "default": "EVENTS_AND_EOD"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AnalyticsPolicy"
      },
      "BuildingGroupRequest": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version"
          },
          "client_event_id": {
            "type": "string",
            "title": "Client Event Id"
          },
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "environment": {
            "type": "string",
            "const": "PAPER",
            "title": "Environment"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "strategy": {
            "$ref": "#/components/schemas/Strategy"
          },
          "signal": {
            "$ref": "#/components/schemas/Signal"
          },
          "trade_group": {
            "$ref": "#/components/schemas/TradeGroupSpec"
          },
          "execution_policy": {
            "$ref": "#/components/schemas/ExecutionPolicy"
          },
          "analytics_policy": {
            "$ref": "#/components/schemas/AnalyticsPolicy"
          },
          "cost_profile_id": {
            "type": "string",
            "title": "Cost Profile Id"
          },
          "tax_profile_id": {
            "type": "string",
            "title": "Tax Profile Id"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "default": {}
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "client_event_id",
          "account_id",
          "environment",
          "source",
          "strategy",
          "signal",
          "trade_group",
          "execution_policy",
          "analytics_policy",
          "cost_profile_id",
          "tax_profile_id"
        ],
        "title": "BuildingGroupRequest"
      },
      "CloseIntent": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version"
          },
          "client_event_id": {
            "type": "string",
            "title": "Client Event Id"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "reason": {
            "type": "string",
            "enum": [
              "STRATEGY_EXIT",
              "MANUAL",
              "TARGET",
              "STOP",
              "TIME",
              "EXPIRY"
            ],
            "title": "Reason"
          },
          "scope": {
            "type": "string",
            "enum": [
              "GROUP",
              "LEGS"
            ],
            "title": "Scope"
          },
          "price_policy": {
            "type": "string",
            "enum": [
              "NEXT_AVAILABLE_BAR_OPEN",
              "LATEST_TRADABLE"
            ],
            "title": "Price Policy"
          },
          "legs": {
            "items": {
              "$ref": "#/components/schemas/CloseLeg"
            },
            "type": "array",
            "title": "Legs",
            "default": []
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata",
            "default": {}
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "client_event_id",
          "occurred_at",
          "reason",
          "scope",
          "price_policy"
        ],
        "title": "CloseIntent"
      },
      "CloseLeg": {
        "properties": {
          "client_leg_id": {
            "type": "string",
            "title": "Client Leg Id"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_leg_id",
          "quantity"
        ],
        "title": "CloseLeg"
      },
      "EntryOrder": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "MARKET",
              "LIMIT",
              "STOP",
              "STOP_LIMIT"
            ],
            "title": "Type"
          },
          "limit_price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              },
              {
                "type": "null"
