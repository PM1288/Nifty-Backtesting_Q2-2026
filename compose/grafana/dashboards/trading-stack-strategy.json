      "options": {
        "mode": "html",
        "content": "<div id=\"a02-params-app\">\n  <style>\n    .sp-card { font-family: 'Segoe UI', Arial, sans-serif; padding: 12px; background: #0f1419; color: #e6edf3; border-radius: 8px; }\n    .sp-header { font-size: 18px; margin-bottom: 6px; font-weight: 600; }\n    .sp-sub { font-size: 12px; color: #9da7b3; margin-bottom: 8px; }\n    .sp-actions { margin: 8px 0; display: flex; gap: 8px; align-items: center; }\n    .sp-actions button { padding: 6px 10px; border-radius: 6px; border: none; background: #1f6feb; color: white; cursor: pointer; }\n    .sp-actions button.secondary { background: #30363d; }\n    .sp-status { margin: 6px 0; font-size: 12px; }\n    .sp-table { width: 100%; border-collapse: collapse; margin-top: 8px; }\n    .sp-table th, .sp-table td { border-bottom: 1px solid #2a2f36; padding: 6px; font-size: 12px; vertical-align: top; }\n    .sp-table th { text-align: left; color: #9da7b3; }\n    .sp-input { padding: 4px 6px; border-radius: 6px; border: 1px solid #2a2f36; background: #141a21; color: #e6edf3; width: 100%; }\n    .sp-pill { display: inline-block; padding: 2px 6px; border-radius: 999px; font-size: 11px; background: #1f6feb; }\n    .sp-pill.default { background: #6e7681; }\n    .sp-desc { color: #8b949e; font-size: 11px; }\n  </style>\n  <div class=\"sp-card\">\n    <div class=\"sp-header\">A02 Strategy Parameters</div>\n    <div class=\"sp-sub\">Percentile + RSI + WILLR + Volume filters used in backtest and live screening.</div>\n    <div class=\"sp-actions\">\n      <button id=\"sp-refresh\" type=\"button\">Refresh</button>\n      <span class=\"sp-status\" id=\"sp-status\"></span>\n    </div>\n    <table class=\"sp-table\">\n      <thead>\n        <tr>\n          <th>Parameter</th>\n          <th>Value</th>\n          <th>Default</th>\n          <th>Updated</th>\n          <th>By</th>\n          <th>Actions</th>\n          <th>Description</th>\n        </tr>\n      </thead>\n      <tbody id=\"sp-body\"></tbody>\n    </table>\n  </div>\n</div>\n<script>\n(function() {\n  const scope = 'backtest_a02';\n  const listUrl = `/backend/strategy/params?scope=${scope}`;\n  const updateBase = '/backend/strategy/params/';\n  const statusEl = document.getElementById('sp-status');\n  const bodyEl = document.getElementById('sp-body');\n\n  function setStatus(msg, ok) {\n    statusEl.textContent = msg;\n    statusEl.style.color = ok ? '#3fb950' : '#f85149';\n  }\n\n  function formatUpdated(ts) {\n    if (!ts) return '-';\n    try {\n      return new Date(ts).toLocaleString();\n    } catch (e) {\n      return ts;\n    }\n  }\n\n  function buildInput(param) {\n    const kind = param.kind;\n    const input = document.createElement('input');\n    input.className = 'sp-input';\n    if (kind === 'bool') {\n      input.type = 'checkbox';\n      input.checked = Boolean(param.value);\n      return input;\n    }\n    if (kind === 'int') {\n      input.type = 'number';\n      input.step = param.step || '1';\n    } else if (kind === 'number') {\n      input.type = 'number';\n      input.step = param.step || 'any';\n    } else {\n      input.type = 'text';\n    }\n    input.value = param.value !== null && param.value !== undefined ? param.value : '';\n    if (param.min !== null && param.min !== undefined) input.min = param.min;\n    if (param.max !== null && param.max !== undefined) input.max = param.max;\n    return input;\n  }\n\n  function readValue(kind, input) {\n    if (kind === 'bool') return input.checked;\n    if (kind === 'int') return parseInt(input.value, 10);\n    if (kind === 'number') return parseFloat(input.value);\n    return input.value;\n  }\n\n  async function updateParam(name, kind, input) {\n    const value = readValue(kind, input);\n    if ((kind === 'int' || kind === 'number') && Number.isNaN(value)) {\n      setStatus('Invalid numeric value for ' + name, false);\n      return;\n    }\n    const res = await fetch(updateBase + encodeURIComponent(name) + `?scope=${scope}`, {\n      method: 'PUT',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ value, updated_by: 'grafana' })\n    });\n    if (!res.ok) {\n      const err = await res.json().catch(() => ({}));\n      setStatus(err.error || 'Update failed', false);\n      return;\n    }\n    setStatus('Updated ' + name, true);\n    await load();\n  }\n\n  async function resetParam(name) {\n    const res = await fetch(updateBase + encodeURIComponent(name) + `?scope=${scope}`, { method: 'DELETE' });\n    if (!res.ok) {\n      const err = await res.json().catch(() => ({}));\n      setStatus(err.error || 'Reset failed', false);\n      return;\n    }\n    setStatus('Reset ' + name, true);\n    await load();\n  }\n\n  function render(params) {\n    bodyEl.innerHTML = '';\n    params.forEach(param => {\n      const tr = document.createElement('tr');\n      const input = buildInput(param);\n      const updateBtn = document.createElement('button');\n      updateBtn.textContent = 'Update';\n      updateBtn.addEventListener('click', () => updateParam(param.name, param.kind, input));\n      const resetBtn = document.createElement('button');\n      resetBtn.textContent = 'Reset';\n      resetBtn.className = 'secondary';\n      resetBtn.addEventListener('click', () => resetParam(param.name));\n      const actionWrap = document.createElement('div');\n      actionWrap.style.display = 'flex';\n      actionWrap.style.gap = '6px';\n      actionWrap.appendChild(updateBtn);\n      actionWrap.appendChild(resetBtn);\n\n      tr.innerHTML = `\n        <td>${param.label || param.name}</td>\n        <td></td>\n        <td>${param.default !== undefined ? param.default : '-'}</td>\n        <td>${formatUpdated(param.updated_at)}</td>\n        <td>${param.updated_by || '-'}</td>\n        <td></td>\n        <td><span class=\"sp-desc\">${param.description || ''}</span></td>\n      `;\n      tr.children[1].appendChild(input);\n      tr.children[5].appendChild(actionWrap);\n      bodyEl.appendChild(tr);\n    });\n  }\n\n  async function load() {\n    setStatus('Loading...', true);\n    const res = await fetch(listUrl);\n    if (!res.ok) {\n      setStatus('Failed to load parameters', false);\n      return;\n    }\n    const data = await res.json();\n    render(data.params || []);\n    setStatus('Loaded ' + (data.params || []).length + ' parameters', true);\n  }\n\n  document.getElementById('sp-refresh').addEventListener('click', load);\n  load();\n})();\n</script>"
