                       "targets":  [
                                       {
                                           "format":  "table",
                                           "rawSql":  "SELECT CASE\n  WHEN s.last_bid IS NULL OR s.last_ask IS NULL THEN NULL\n  ELSE s.last_ask - s.last_bid\nEND AS value\nFROM instrument_state s\nJOIN instrument_universe u ON u.exchange = s.exchange AND u.symbol_token = s.symbol_token\nWHERE u.tradingsymbol = \u0027$symbol\u0027\nORDER BY s.last_seen_ts DESC\nLIMIT 1;",
