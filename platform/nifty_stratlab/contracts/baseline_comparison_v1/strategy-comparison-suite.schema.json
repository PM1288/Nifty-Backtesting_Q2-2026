{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.novius2/schemas/strategy-comparison-suite-v1.json",
  "title": "Strategy Comparison Suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suite_id",
    "version",
    "display_name",
    "description",
    "status",
    "strategies",
    "tiers",
    "fairness_contract",
    "benchmarks",
    "required_metrics",
    "required_breakdowns",
    "ui_routes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "enum": [
        "reference",
        "validated",
        "retired"
      ]
    },
    "strategies": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy_version_id",
          "strategy_file",
          "role",
          "tier"
        ],
        "properties": {
          "strategy_version_id": {
            "type": "string"
          },
          "strategy_file": {
            "type": "string"
          },
          "role": {
            "enum": [
              "control",
              "candidate"
            ]
          },
          "tier": {
            "enum": [
              1,
              2
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier_1",
        "tier_2"
      ],
      "properties": {
        "tier_1": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tier_2": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fairness_contract": {
      "type": "object",
      "additionalProperties": true
    },
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "required_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_breakdowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ui_routes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}