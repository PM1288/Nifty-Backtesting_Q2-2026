      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COALESCE(u.tradingsymbol, subs.tradingsymbol, p.symbol_token) AS symbol,\n       p.strategy,\n       p.side,\n       p.qty,\n       p.avg_price,\n       p.stop_loss,\n       p.take_profit,\n       p.mark_price,\n       p.unrealized_calc AS unrealized_pnl,\n       p.total_pnl,\n       p.updated_at\nFROM paper_pnl p\nLEFT JOIN instrument_universe u ON u.exchange = p.exchange AND u.symbol_token = p.symbol_token\nLEFT JOIN subscriptions subs ON subs.symbol_token = p.symbol_token\nUNION ALL\nSELECT 'NO_OPEN_POSITIONS' AS symbol,\n       'system' AS strategy,\n       'NA' AS side,\n       0::numeric AS qty,\n       0::numeric AS avg_price,\n       0::numeric AS stop_loss,\n       0::numeric AS take_profit,\n       0::numeric AS mark_price,\n       0::numeric AS unrealized_pnl,\n       0::numeric AS total_pnl,\n       now() AS updated_at\nWHERE NOT EXISTS (SELECT 1 FROM paper_pnl)\nORDER BY updated_at DESC;",
          "refId": "A"
        }
      ],
