      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT run_id AS \"time\", total_net_profit AS value\nFROM a02_archive_swing_runs\nUNION ALL\nSELECT now() AS \"time\", 0::double precision AS value\nWHERE NOT EXISTS (SELECT 1 FROM a02_archive_swing_runs)\nORDER BY 1;",
