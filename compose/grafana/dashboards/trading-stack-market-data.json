                       "type":  "table",
                       "title":  "Depth (Top 5)",
                       "datasource":  {
                                          "type":  "postgres",
                                          "uid":  "postgres"
                                      },
                       "gridPos":  {
                                       "x":  0,
                                       "y":  18,
                                       "w":  24,
                                       "h":  10
                                   },
                       "targets":  [
                                       {
                                           "format":  "table",
                                           "rawSql":  "WITH latest AS (SELECT max(d.ts) AS ts FROM depth_5_snapshots d JOIN instrument_universe u ON u.exchange = d.exchange AND u.symbol_token = d.symbol_token WHERE u.tradingsymbol = \u0027$symbol\u0027) SELECT d.side, d.level, d.price, d.quantity, d.orders FROM depth_5_snapshots d JOIN instrument_universe u ON u.exchange = d.exchange AND u.symbol_token = d.symbol_token JOIN latest l ON d.ts = l.ts WHERE u.tradingsymbol = \u0027$symbol\u0027 ORDER BY d.side DESC, d.level;",
                                           "refId":  "A"
                                       }
                                   ],
                       "options":  {
                                       "showHeader":  true
                                   }
                   },
