      "options": {
        "mode": "html",
        "content": "<style>\n.home-wrap{font-family:Segoe UI,Arial,sans-serif;padding:8px} .home-title{margin:0 0 8px 0;font-size:24px;letter-spacing:.2px} .home-sub{margin:0 0 16px 0;opacity:.85} .home-grid{display:grid;grid-template-columns:repeat(3,minmax(220px,1fr));gap:12px} .home-card{border:1px solid #2f3f59;border-radius:12px;padding:12px;background:linear-gradient(180deg,#19263a 0%,#121a28 100%)} .home-card h3{margin:0 0 10px 0;font-size:15px} .btn-grid{display:grid;grid-template-columns:1fr;gap:8px} .nav-btn{display:block;text-decoration:none !important;color:#fff !important;font-weight:600;padding:10px 12px;border-radius:10px;border:1px solid #35507a;background:linear-gradient(90deg,#1e3352 0%,#2a4c7f 100%);transition:all .2s ease} .nav-btn:hover{transform:translateY(-1px);border-color:#6fa8ff;background:linear-gradient(90deg,#2b4f7f 0%,#3b6eb2 100%)} .api-btn{background:linear-gradient(90deg,#23304a 0%,#2e466d 100%)} .accent{display:inline-block;padding:4px 10px;border-radius:999px;background:#18324f;border:1px solid #35507a;font-size:12px;margin-bottom:8px}</style>\n<div class='home-wrap'>\n  <div class='accent'>Trading Stack Navigation</div>\n  <h2 class='home-title'>DigiTrader Home</h2>\n  <p class='home-sub'>Fast navigation for dashboards, trading apps, and APIs. Use the top <b>Navigate Dashboards</b> control or these direct buttons.</p>\n  <div class='home-grid'>\n    <div class='home-card'>\n      <h3>Dashboards</h3>\n      <div class='btn-grid'>\n        <a class='nav-btn' href='/d/trading-stack-overview' target='_self'>Trading Stack Overview</a>\n        <a class='nav-btn' href='/d/trading-stack-trading' target='_self'>Trading Live</a>\n        <a class='nav-btn' href='/d/trading-stack-market-data' target='_self'>Market Data &amp; Depth</a>\n        <a class='nav-btn' href='/d/trading-stack-strategy' target='_self'>Strategy + Paper Trading</a>\n        <a class='nav-btn' href='/d/trading-stack-watchlist' target='_self'>Watchlist Alerts</a>\n        <a class='nav-btn' href='/d/trading-stack-backtest' target='_self'>Backtest Equity & Options</a>\n        <a class='nav-btn' href='/d/trading-stack-equilibrium' target='_self'>Options Equilibrium</a>\n        <a class='nav-btn' href='/d/trading-stack-option-greeks' target='_self'>Option Greeks</a>\n        <a class='nav-btn' href='/d/trading-stack-max-pain' target='_self'>Max Pain</a>\n      </div>\n    </div>\n    <div class='home-card'>\n      <h3>Native Apps</h3>\n      <div class='btn-grid'>\n        <a class='nav-btn' href='/paper' target='_self'>Paper Trades UI</a>\n        <a class='nav-btn' href='/digii4/manual-trackers' target='_self'>Manual Trackers UI</a>\n        <a class='nav-btn' href='/watcher' target='_self'>Nifty Watcher UI</a>\n        <a class='nav-btn' href='/watcher/manual-options' target='_self'>Manual Option Trades UI</a>\n        <a class='nav-btn' href='/rsi-willr/' target='_self'>RSI + WILLR Monitor</a>\n        <a class='nav-btn' href='/option-chain/' target='_self'>Option Chain Watcher UI</a>\n        <a class='nav-btn' href='/n8n/' target='_self'>n8n UI</a>\n        <a class='nav-btn' href='/gateway/' target='_self'>Gateway UI</a>\n      </div>\n    </div>\n    <div class='home-card'>\n      <h3>Health + API</h3>\n      <div class='btn-grid'>\n        <a class='nav-btn api-btn' href='/backend/healthz' target='_blank'>Watchlist Health</a>\n        <a class='nav-btn api-btn' href='/rsi-willr/api/healthz' target='_blank'>RSI/WILLR Health</a>\n        <a class='nav-btn api-btn' href='/option-chain/healthz' target='_blank'>Option Chain Health</a>\n        <a class='nav-btn api-btn' href='/option-chain/api/latest' target='_blank'>Option Chain Latest Snapshot</a>\n        <a class='nav-btn api-btn' href='/backend/paper/summary' target='_blank'>Paper Summary API</a>\n        <a class='nav-btn api-btn' href='/backend/digii4/manual-trackers' target='_blank'>Manual Trackers API</a>\n        <a class='nav-btn api-btn' href='/backend/watcher/summary' target='_blank'>Watcher Summary API</a>\n        <a class='nav-btn api-btn' href='/backend/watcher/manual-options' target='_blank'>Manual Option Trades API</a>\n        <a class='nav-btn api-btn' href='/api/mobile/v1/search?query=trading' target='_blank'>Mobile BFF Search API</a>\n      </div>\n    </div>\n  </div>\n</div>"
